# Runtime credentials
# Provider mapping in this repo:
# - quan2go = VISION_QUAN2GO_API_KEY + VISION_QUAN2GO_BASE_URL
# - lemonapi = VISION_LEMONAPI_API_KEY + VISION_LEMONAPI_BASE_URL + VISION_LEMONAPI_MODEL
# - auto-code = OPENAI_API_KEY + VISION_AUTO_CODE_BASE_URL
# Both are OpenAI-compatible proxy/gateway endpoints here.
APIFY_TOKEN=
APIFY_BACKUP_TOKENS=
APIFY_FREE_TOKENS=
# paid_first_free_fallback = paid tokens first, free tokens only handle guarded overflow
APIFY_TOKEN_POOL_STRATEGY=paid_first_free_fallback
# local hard cap for each free fallback token, even when remote monthly limit is higher
APIFY_FREE_TOKEN_HARD_LIMIT_USD=5.0
APIFY_MAX_BATCH_ATTEMPTS=3
APIFY_BUDGET_SAFETY_MULTIPLIER=1.1
APIFY_BUDGET_BUFFER_USD=0.1
APIFY_BUDGET_RESERVATION_TTL_SECONDS=21600
APIFY_RUN_GUARD_TTL_SECONDS=1800
TIKTOK_BATCH_SIZE=20
INSTAGRAM_BATCH_SIZE=50
YOUTUBE_BATCH_SIZE=5
APIFY_TIKTOK_COST_PER_RESULT_USD=0.004
APIFY_INSTAGRAM_COST_PER_RESULT_USD=0.0027
APIFY_YOUTUBE_COST_PER_RESULT_USD=0.004
OPENAI_API_KEY=
VISION_QUAN2GO_API_KEY=
VISION_LEMONAPI_API_KEY=

# Runtime endpoints
VISION_QUAN2GO_BASE_URL=https://capi.quan2go.com/openai
VISION_LEMONAPI_BASE_URL=https://new.lemonapi.site/v1
VISION_AUTO_CODE_BASE_URL=https://gpt.auto-code.net/rust/openai/v1
VISION_LEMONAPI_MODEL=[L]gemini-3.1-pro-preview
VISION_MODEL=gpt-5.4

# Local runtime defaults
BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=5001
# Optional local override for custom Python interpreter
# BACKEND_PYTHON=/absolute/path/to/python
